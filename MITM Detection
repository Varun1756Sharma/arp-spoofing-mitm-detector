from scapy.all import sniff, ARP
from datetime import datetime

arp_table = {}
mac_table = {}

log_file = "attack_log.txt"

print("Monitoring ARP packets... Press CTRL+C to stop\n")

def write_log(message):
    time = datetime.now().strftime('%H:%M:%S')
    log_entry = f"[{time}] {message}\n"
    
    print(log_entry)  # console pe bhi show
    with open(log_file, "a") as f:
        f.write(log_entry)

def detect_attack(packet):
    if packet.haslayer(ARP):
        ip = packet.psrc
        mac = packet.hwsrc

        write_log(f"[INFO] {ip} -> {mac}")

        # ARP Spoofing
        if ip in arp_table:
            if arp_table[ip] != mac:
                write_log("[ ALERT] ARP Spoofing Detected!")
                write_log(f"IP: {ip}")
                write_log(f"Original MAC: {arp_table[ip]}")
                write_log(f"Fake MAC: {mac}")

        arp_table[ip] = mac

       
        if mac in mac_table:
            if mac_table[mac] != ip:
                write_log("[ ALERT] Possible MITM Attack!")
                write_log(f"MAC: {mac}")
                write_log(f"IPs: {mac_table[mac]} , {ip}")

        mac_table[mac] = ip


sniff(filter="arp", prn=detect_attack, store=False, iface="Wi-Fi")
